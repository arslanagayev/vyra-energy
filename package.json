{
  "name": "vyra-energy",
  "version": "1.0.0",
  "private": true,
  "description": "A scroll-driven 3D product website for a concept energy drink, built with Three.js, GSAP ScrollTrigger and TypeScript.",
  "keywords": [
    "threejs",
    "webgl",
    "gsap",
    "scrolltrigger",
    "lenis",
    "typescript",
    "vite",
    "3d-website",
    "product-page"
  ],
  "author": {
    "name": "Arslan Agayev",
    "url": "https://github.com/arslanagayev"
  },
  "license": "MIT",
  "homepage": "https://arslanagayev.github.io/vyra-energy/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arslanagayev/vyra-energy.git"
  },
  "bugs": {
    "url": "https://github.com/arslanagayev/vyra-energy/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
